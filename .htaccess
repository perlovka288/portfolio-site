# ✅ ИСПРАВЛЕННЫЙ .htaccess с скрытием .php и улучшениями

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ──────────────────────────────────────────────────────────
# ✅ СКРЫВАЕМ .php РАСШИРЕНИЕ из URL
# ──────────────────────────────────────────────────────────

# Если файл/папка существует - ничего не делаем
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Переписываем запросы без .php в файлы с .php (невидимо)
# Например: /order → /order.php, но URL остаётся /order
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ $1.php?$2 [QSA,L]

# GET параметры передаём как есть (QSA = Query String Append)
# Например: /order?service=preview остаётся /order?service=preview

</IfModule>

# ── Индексный файл ──
DirectoryIndex index.php index.html

# ── Лимиты загрузки ──
# ВАЖНО: этот .htaccess (AllowOverride All) перебивает php.ini/conf.d —
# раньше здесь стояло post_max_size 34M, хотя Dockerfile ставит 500M.
# Из-за этого при заказе с несколькими фото (ТЗ до 40 файлов) PHP резал
# запрос на 34 МБ и выдавал "POST Content-Length ... exceeds the limit",
# а это, в свою очередь, срывало session_start() ниже по коду (headers
# already sent) и ломало проверку Turnstile. Подняли до значений из
# Dockerfile, чтобы .htaccess их не перебивал.
php_value upload_max_filesize 100M
php_value post_max_size 500M
php_value memory_limit 256M
php_value max_execution_time 300
php_value max_input_time 300

# ── Безопасность ──
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    # ── SameSite куки для Safari/iOS ──
    Header always edit Set-Cookie (.*) "$1; SameSite=None; Secure"
</IfModule>

# ── Защита от доступа к чувствительным файлам ──
<FilesMatch "^(\.env|composer\.json|\.git|config|database)">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Сжатие (HTML/CSS/JS в 5–8 раз меньше по сети — заметно на телефоне) ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ── Кэширование статических файлов ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>

# Cache-Control для статики: браузер и Cloudflare держат файлы в кеше, не дёргая сервер
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
