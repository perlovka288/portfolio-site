+// ─── Загрузчик исходников: до 40 файлов, drag&drop, превью, удаление по одному ───
+var REFS_MAX_FILES = 40;
+var refsFileStore = {}; // { slotNumber: File[] }
+
+function initRefsUploader(slot) {
+    var input = document.getElementById('s' + slot + '_refs');
+    var zone = document.getElementById('s' + slot + '_refs_dropzone');
+    if (!input || !zone) return;
+    refsFileStore[slot] = [];
+
+    input.addEventListener('change', function() {
+        addRefsFiles(slot, Array.from(this.files || []));
+        this.value = ''; // сбрасываем, т.к. файлы теперь живут в refsFileStore
+    });
+
+    ['dragenter','dragover'].forEach(function(evt) {
+        zone.addEventListener(evt, function(e) {
+            e.preventDefault(); e.stopPropagation();
+            zone.classList.add('dragover');
+        });
+    });
+    ['dragleave','drop'].forEach(function(evt) {
+        zone.addEventListener(evt, function(e) {
+            e.preventDefault(); e.stopPropagation();
+            if (evt === 'dragleave' && e.target !== zone) return;
+            zone.classList.remove('dragover');
+        });
+    });
+    zone.addEventListener('drop', function(e) {
+        var dropped = e.dataTransfer && e.dataTransfer.files ? Array.from(e.dataTransfer.files) : [];
+        if (dropped.length) addRefsFiles(slot, dropped);
+    });
+}
+
+function addRefsFiles(slot, newFiles) {
+    var store = refsFileStore[slot] || (refsFileStore[slot] = []);
+    var room = REFS_MAX_FILES - store.length;
+    if (room <= 0) {
+        showToastMsg('⚠️ Максимум ' + REFS_MAX_FILES + ' файлов за один заказ', '#ef4444');
+        renderRefsPreview(slot);
+        return;
+    }
+    var toAdd = newFiles.slice(0, room);
+    store.push.apply(store, toAdd);
+    if (newFiles.length > toAdd.length) {
+        showToastMsg('⚠️ Добавлено ' + toAdd.length + ' из ' + newFiles.length + ' — лимит ' + REFS_MAX_FILES + ' файлов', '#f97316');
+    }
+    syncRefsInput(slot);
+    renderRefsPreview(slot);
+}
+
+function removeRefsFile(slot, index) {
+    var store = refsFileStore[slot] || [];
+    store.splice(index, 1);
+    syncRefsInput(slot);
+    renderRefsPreview(slot);
+}
+
+// Переносим управляемый JS-массив файлов обратно в реальный <input type="file">
+// через DataTransfer, чтобы обычная отправка формы (multipart) тоже видела все файлы.
+function syncRefsInput(slot) {
+    var input = document.getElementById('s' + slot + '_refs');
+    if (!input) return;
+    var dt = new DataTransfer();
+    (refsFileStore[slot] || []).forEach(function(f) { dt.items.add(f); });
+    input.files = dt.files;
+}
+
+function renderRefsPreview(slot) {
+    var store = refsFileStore[slot] || [];
+    var grid = document.getElementById('s' + slot + '_refs_preview');
+    var nameEl = document.getElementById('s' + slot + '_refs_name');
+    var countEl = document.getElementById('s' + slot + '_refs_count');
+    if (countEl) {
+        countEl.textContent = store.length + ' / ' + REFS_MAX_FILES;
+        countEl.classList.toggle('file-count-max', store.length >= REFS_MAX_FILES);
+    }
+    if (nameEl) {
+        if (store.length > 0) { nameEl.textContent = '✅ Выбрано файлов: ' + store.length; nameEl.classList.add('has-file'); }
+        else { nameEl.textContent = 'Файлы не выбраны'; nameEl.classList.remove('has-file'); }
+    }
+    if (!grid) return;
+    grid.innerHTML = '';
+    store.forEach(function(file, idx) {
+        var item = document.createElement('div');
+        item.className = 'file-preview-item';
+        if (file.type && file.type.indexOf('image/') === 0) {
+            var img = document.createElement('img');
+            img.src = URL.createObjectURL(file);
+            img.onload = function() { URL.revokeObjectURL(img.src); };
+            item.appendChild(img);
+        } else {
+            item.classList.add('is-doc');
+            var ext = (file.name.split('.').pop() || 'файл').toUpperCase().slice(0, 5);
+            item.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><span class="doc-ext">.' + ext + '</span>';
+        }
+        var rm = document.createElement('button');
+        rm.type = 'button'; rm.className = 'file-preview-remove'; rm.title = 'Удалить'; rm.textContent = '✕';
+        rm.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); removeRefsFile(slot, idx); });
+        item.appendChild(rm);
+        grid.appendChild(item);
+    });
+}
